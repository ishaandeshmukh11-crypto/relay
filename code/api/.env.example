# TWWIOS Relay API — copy to .env and fill from your secret manager.
# Never commit real secrets.

PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB (required in production)
MONGODB_URI=mongodb://127.0.0.1:27017/twwios_relay
# Local trials only — refused when NODE_ENV=production:
# RELAY_ALLOW_MEMORY=1

# Public web origin(s)
PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# Production requires PUBLIC_URL, CORS_ORIGIN, WA_VERIFY_TOKEN, WA_APP_SECRET, RESEND_API_KEY, MAIL_FROM

# Auth / encryption (production: 32+ random characters each)
AUTH_SECRET=replace-with-32-plus-random-characters!!
ENC_KEY=replace-with-another-32-plus-random-key!!

# WhatsApp / Meta
WA_VERIFY_TOKEN=replace-with-verify-token
WA_APP_SECRET=replace-with-meta-app-secret
FB_APP_ID=
FB_APP_SECRET=
WA_CONFIG_ID=
# GRAPH_BASE=https://graph.facebook.com/v21.0
# CANARY_WAIT_MS=120000
# RELAY_RATE=20
# WA_FETCH_TIMEOUT_MS=20000
# TICK_MS=3000

# Email (required in production)
RESEND_API_KEY=
MAIL_FROM=Relay <no-reply@yourdomain.com>
# RESEND_BASE=https://api.resend.com

# Billing — USD (Stripe) guide prices: Starter $49 / Growth $149
BILLING_CURRENCY=USD
BILLING_GRACE_DAYS=3
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_GROWTH_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_GROWTH_YEAR=

# INR (Razorpay) — disabled until INR_PRICES_APPROVED=1 and plan ids are set
INR_PRICES_APPROVED=0
PRICE_STARTER=1999
PRICE_GROWTH=4999
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
# RAZORPAY_BASE=https://api.razorpay.com/v1

# Admin (manual plan activation)
RELAY_ADMIN_KEY=
# Legacy alias still read if RELAY_ADMIN_KEY is empty:
# PULSE_ADMIN_KEY=

# Optional
# SENTRY_DSN=
# AUTH_RATE_LIMIT=20
