# TWWIOS Relay web (Next.js) — copy to .env.local for local development.
# On Vercel, set these in Project → Settings → Environment Variables.

# Backend origin for Next.js rewrites (server-side). Not a NEXT_PUBLIC secret.
# Local: http://localhost:4000
# Production: https://YOUR-RENDER-API.onrender.com  (no trailing slash)
API_URL=http://localhost:4000

# Optional public company facts for legal pages (do not invent values)
# NEXT_PUBLIC_COMPANY_LEGAL_NAME=
# NEXT_PUBLIC_COMPANY_ADDRESS=
# NEXT_PUBLIC_COMPANY_GSTIN=
# NEXT_PUBLIC_COMPANY_PHONE=
# NEXT_PUBLIC_COMPANY_EMAIL=
# NEXT_PUBLIC_DATA_DELETION_EMAIL=

# Optional browser monitoring (public DSN only)
# NEXT_PUBLIC_SENTRY_DSN=
